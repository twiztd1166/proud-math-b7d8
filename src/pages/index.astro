---
// Public Paradise Shows frontend. Live operational data remains in Supabase.
---
<!doctype html>
<html lang="en">
<head>
  <meta http-equiv="Content-Security-Policy" content="default-src 'self'; connect-src 'self' https://taxlrlfsobtnbasjcnuf.supabase.co; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; manifest-src 'self'; base-uri 'none'; object-src 'none'; form-action 'self'; upgrade-insecure-requests" />
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover" />
  <meta name="theme-color" content="#f4f6f8" />
  <meta name="color-scheme" content="light" />
  <meta name="application-name" content="Paradise Shows" />
  <meta name="mobile-web-app-capable" content="yes" />
  <meta name="apple-mobile-web-app-capable" content="yes" />
  <meta name="apple-mobile-web-app-status-bar-style" content="default" />
  <meta name="apple-mobile-web-app-title" content="Paradise Shows" />
  <meta name="format-detection" content="telephone=no" />
  <link rel="manifest" href="manifest.webmanifest" />
  <link rel="apple-touch-icon" href="icon.svg" />
  <title>Paradise Shows</title>
  <link rel="stylesheet" href="/app.css?v=20260930-action-aware-v6" />
</head>
<body>
<div class="app">
  <header class="top">
    <div class="toprow">
      <div class="brandLockup">
        <img class="brandIcon" src="/icon.svg" alt="" aria-hidden="true" />
        <div><div class="brand">Paradise Shows</div><div id="asOf" class="sub">Loading current control state…</div></div>
      </div>
      <div class="topActions">
        <div class="live"><span class="dot"></span><span>Live</span></div>
        <button id="refreshBtn" class="refresh iconButton" aria-label="Reload current data" title="Reload current data">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20 11a8 8 0 1 0-2.34 5.66M20 4v7h-7"/></svg>
        </button>
      </div>
    </div>
  </header>
  <main id="content" class="content"><div class="loading appSkeleton" aria-live="polite"><span></span><span></span><span></span></div></main>
</div>

<nav class="bottom" aria-label="Primary"><div class="nav">
  <button data-tab="today" class="active" aria-label="Next steps"><span class="ico"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 11l2 2 4-5"/><path d="M12 21a9 9 0 1 0-9-9 9 9 0 0 0 9 9Z"/></svg></span><span class="navLabel">Next</span></button>
  <button data-tab="calendar" aria-label="Calendar"><span class="ico"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 3v3M18 3v3M4 8h16"/><rect x="3" y="5" width="18" height="16" rx="3"/><path d="M7 12h3M14 12h3M7 16h3M14 16h3"/></svg></span><span class="navLabel">Calendar</span></button>
  <button data-tab="shows" aria-label="Shows and history"><span class="ico"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 4h14v16H5z"/><path d="M8 8h8M8 12h8M8 16h5"/></svg></span><span class="navLabel">Shows</span></button>
  <button data-tab="payments" aria-label="Payments"><span class="ico"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M15 8.5c-.7-.7-1.7-1-3-1-1.7 0-3 .8-3 2s1.1 1.8 3.2 2.2c2 .4 2.8 1 2.8 2.2 0 1.3-1.3 2.1-3.2 2.1-1.2 0-2.4-.4-3.3-1.2M12 6v12"/></svg></span><span class="navLabel">Payments</span></button>
  <button data-tab="control" aria-label="More"><span class="ico"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="5" cy="12" r="1.5"/><circle cx="12" cy="12" r="1.5"/><circle cx="19" cy="12" r="1.5"/></svg></span><span class="navLabel">More</span></button>
</div></nav>

<div id="detailModal" class="modal"><div class="sheet"><div class="handle"></div><div id="detailBody"></div></div></div>
<div id="editModal" class="modal"><div class="sheet"><div class="handle"></div><div id="editBody"></div></div></div>
<div id="paymentModal" class="modal"><div class="sheet"><div class="handle"></div><div id="paymentBody"></div></div></div>
<div id="filterModal" class="modal"><div class="sheet filterSheet"><div class="handle"></div><div id="filterBody"></div></div></div>
<div id="toast" class="toast"></div>

<script is:inline src="/app-core.js?v=20260930-action-aware-v6"></script>
<script is:inline src="/app-annual-api.js?v=20260930-action-aware-v6"></script>
<script is:inline src="/app-shows.js?v=20260930-action-aware-v6"></script>
<script is:inline src="/app-calendar.js?v=20260930-action-aware-v6"></script>
<script is:inline src="/app-annual-scope.js?v=20260930-action-aware-v6"></script>
<script is:inline src="/app-control.js?v=20260930-action-aware-v6"></script>
<script is:inline src="/app-bind.js?v=20260930-action-aware-v6"></script>
<script is:inline src="/app-modals.js?v=20260930-action-aware-v6"></script>
</body></html>
