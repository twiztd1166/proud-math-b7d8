---
// Public Paradise Shows frontend. Live operational data remains in Supabase.
---
<!doctype html>
<html lang="en">
<head>
  <meta http-equiv="Content-Security-Policy" content="default-src 'self'; connect-src 'self' https://taxlrlfsobtnbasjcnuf.supabase.co; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; manifest-src 'self'; base-uri 'none'; object-src 'none'; form-action 'self'; upgrade-insecure-requests" />
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover" />
  <meta name="theme-color" content="#102c46" />
  <meta name="apple-mobile-web-app-capable" content="yes" />
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
  <meta name="apple-mobile-web-app-title" content="Paradise Shows" />
  <link rel="manifest" href="manifest.webmanifest" />
  <link rel="apple-touch-icon" href="icon.svg" />
  <title>Paradise Shows</title>
  <link rel="stylesheet" href="/app.css" />
</head>
<body>
<div class="app">
  <header class="top">
    <div class="toprow">
      <div><div class="brand">Paradise Shows</div><div id="asOf" class="sub">Loading current control state…</div></div>
      <div style="display:flex;gap:7px;align-items:center"><button id="refreshBtn" class="refresh">Reload</button><div class="live"><span class="dot"></span>LIVE</div></div>
    </div>
  </header>
  <main id="content" class="content"><div class="loading">Loading shows…</div></main>
</div>

<nav class="bottom"><div class="nav">
  <button data-tab="today" class="active"><span class="ico">✓</span>Today</button>
  <button data-tab="shows"><span class="ico">▤</span>Shows</button>
  <button data-tab="payments"><span class="ico">$</span>Payments</button>
  <button data-tab="control"><span class="ico">◎</span>Control</button>
</div></nav>

<div id="detailModal" class="modal"><div class="sheet"><div class="handle"></div><div id="detailBody"></div></div></div>
<div id="editModal" class="modal"><div class="sheet"><div class="handle"></div><div id="editBody"></div></div></div>
<div id="paymentModal" class="modal"><div class="sheet"><div class="handle"></div><div id="paymentBody"></div></div></div>
<div id="filterModal" class="modal"><div class="sheet filterSheet"><div class="handle"></div><div id="filterBody"></div></div></div>
<div id="toast" class="toast"></div>

<script is:inline src="/app-core.js"></script>
<script is:inline src="/app-shows.js"></script>
<script is:inline src="/app-control.js"></script>
<script is:inline src="/app-bind.js"></script>
<script is:inline src="/app-modals.js"></script>
</body></html>

