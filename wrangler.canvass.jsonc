{
  "name": "paradise-canvass-manager",
  "compatibility_date": "2026-08-14",
  "main": "./canvass-worker.js",
  "assets": {
    "directory": "./canvass-dist",
    "binding": "ASSETS"
  },
  "routes": [
    {
      "pattern": "canvass.paradiseexteriors.com",
      "custom_domain": true
    }
  ],
  "observability": {
    "enabled": true
  }
}
